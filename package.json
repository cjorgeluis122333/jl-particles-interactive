{
  "name": "jl-particle-interactive-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@jl-particle-interactive/web",
    "build": "npm run build:library && npm run build:web",
    "build:library": "npm run build --workspace=jl-particle-interactive",
    "build:web": "npm run build --workspace=@jl-particle-interactive/web",
    "lint": "npm run lint --workspaces --if-present",
    "publish:library": "npm publish --workspace=jl-particle-interactive --access public"
  }
}
